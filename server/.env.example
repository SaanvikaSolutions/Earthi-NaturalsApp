# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# MongoDB Atlas connection string.
# IMPORTANT: if your password contains special characters (@ # ! etc.) you MUST
# percent-encode them. e.g.  @ -> %40   # -> %23   ! -> %21
# Atlas -> Database -> Connect -> Drivers gives you the exact string.
MONGO_URI=mongodb+srv://USER:URL_ENCODED_PASSWORD@cluster0.wjv9rks.mongodb.net/earthi?retryWrites=true&w=majority&appName=Cluster0

# Database name (also encoded in the URI path above; kept here for clarity).
DB_NAME=earthi

# Secret used to sign JWT auth tokens. Use a long random string.
JWT_SECRET=change_me_to_a_long_random_string

# Port the API listens on.
PORT=4000

# --- Razorpay ---
# Key ID is public (it ships in the app); the secret is server-only and must
# never be committed or sent to the client.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
# From Dashboard -> Settings -> Webhooks. Leave blank to disable the webhook.
RAZORPAY_WEBHOOK_SECRET=
