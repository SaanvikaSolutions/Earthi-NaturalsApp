<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Android 9+ blocks cleartext by default. The dev API is plain http, so
         allow it for the local hosts only — a deployed https API is unaffected,
         and no other domain may fall back to cleartext. Delete this file once
         the app points at a real https backend. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.104</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
